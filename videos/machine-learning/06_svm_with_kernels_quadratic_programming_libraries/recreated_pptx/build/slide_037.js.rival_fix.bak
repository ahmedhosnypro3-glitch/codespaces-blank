// Slide 037 — REBUILD WAVE 3 (fix 2 after judge FAIL rb3fix3).
// Built ONLY from qa/reanalysis2/slide_037_analysis.txt + judge findings:
// square-corner panels, tight example box, white framed boxes around w/b rows,
// peach strip behind class-of-vector lines, small outlined red arrow, kernelize
// in a white label box inside the middle panel.
// Build from project root: cd /home/codespace/ai_llm_slides && node <NS>/recreated_pptx/build/slide_037.js
const fs = require("fs");
const path = require("path");
const pptxgen = require("pptxgenjs");

const NS = "/home/codespace/ai_llm_slides/videos/machine-learning/06_svm_with_kernels_quadratic_programming_libraries";
const NUM = 37;
const W = 13.33, H = 7.5;
const EQ = path.join(__dirname, "eq_037");
const OUT = path.join(NS, "recreated_pptx", "slide_037_recreated.pptx");
const M = JSON.parse(fs.readFileSync(path.join(EQ, "s37w3_manifest.json"), "utf8"));
const FONT = "Times New Roman";
const N = b => ({ x: b[0] * W, y: b[1] * H, w: (b[2] - b[0]) * W, h: (b[3] - b[1]) * H });

const pres = new pptxgen();
pres.layout = "LAYOUT_WIDE";
const s = pres.addSlide();
s.background = { color: "E8E8E8" };

// ---- house chrome (mandatory, overrides spec geometry) ----
s.addShape(pres.shapes.RECTANGLE, {
  x: 0.15, y: 0.15, w: W - 0.3, h: H - 0.3,
  fill: { type: "none" }, line: { color: "C00000", width: 1.5 },
});
s.addShape(pres.shapes.OVAL, {
  x: 12.48, y: 0.30, w: 0.5, h: 0.5,
  fill: { color: "FFF9C4" }, line: { color: "FFF9C4", width: 0.5 },
});
s.addText(String(NUM), {
  x: 12.48, y: 0.30, w: 0.5, h: 0.5, align: "center", valign: "middle",
  fontSize: 18, bold: true, color: "333333", fontFace: FONT, margin: 0,
});

// ---- helpers ----
function box(b, fill, line) {
  const opt = Object.assign(N(b), { line: { color: line, width: 1.25 } });
  if (fill) opt.fill = { color: fill }; else opt.fill = { type: "none" };
  s.addShape(pres.shapes.RECTANGLE, opt);
}
function hl(b, color) {
  s.addShape(pres.shapes.RECTANGLE,
    Object.assign(N(b), { fill: { color: color || "90EE90" }, line: { type: "none" } }));
}

// ---- spec section 4 boxes (square corners per original; drawn before title) ----
box([0.07, 0.07, 0.93, 0.16], "FFFFFF", "00008B");
box([0.07, 0.17, 0.93, 0.45], "F5F5F5", "00008B");
box([0.07, 0.49, 0.93, 0.61], "E0E0E0", "00008B");
box([0.07, 0.62, 0.93, 0.93], "F5F5F5", "00008B");
box([0.08, 0.075, 0.28, 0.135], null, "00008B"); // tight example box, outline only

// ---- house title (after boxes so nothing covers it) ----
s.addText("How to Kernelize SVM", {
  x: 0.6, y: 0.28, w: 12.13, h: 0.55, align: "center", valign: "top",
  fontSize: 24, bold: true, color: "C00000", fontFace: FONT, margin: 0,
});

// ---- example label (verbatim; blue italic per original) ----
s.addText("Example: Polynomial Kernel", Object.assign(N([0.08, 0.075, 0.28, 0.135]), {
  align: "left", valign: "middle", fontSize: 12, italic: true, color: "0000FF",
  fontFace: FONT, margin: 0.02,
}));

// ---- green term highlights + peach class-line strips (under equations) ----
hl([0.1, 0.2, 0.2, 0.25]); hl([0.1, 0.3, 0.2, 0.35]); hl([0.3, 0.3, 0.5, 0.35]);
hl([0.6, 0.3, 0.8, 0.35]);
hl([0.2, 0.4, 0.8, 0.45], "FFDAB9");
hl([0.4, 0.5, 0.75, 0.55]);
hl([0.1, 0.64, 0.2, 0.69]); hl([0.1, 0.73, 0.2, 0.78]); hl([0.3, 0.73, 0.5, 0.78]);
hl([0.6, 0.73, 0.8, 0.78]);
hl([0.2, 0.83, 0.8, 0.88], "FFDAB9");

// ---- white framed boxes around the w and b rows (both panels) ----
box([0.09, 0.29, 0.31, 0.36], "FFFFFF", "00008B");
box([0.34, 0.29, 0.91, 0.36], "FFFFFF", "00008B");
box([0.56, 0.505, 0.79, 0.565], "FFFFFF", "00008B"); // kernelize label box
box([0.09, 0.72, 0.31, 0.79], "FFFFFF", "00008B");
box([0.34, 0.72, 0.91, 0.79], "FFFFFF", "00008B");

// ---- small thin outlined red down-arrow (per original) ----
s.addShape(pres.shapes.DOWN_ARROW, Object.assign(N([0.47, 0.49, 0.53, 0.55]), {
  fill: { type: "none" }, line: { color: "FF0000", width: 1.5 },
}));
// ---- equations (spec section 8 boxes): centered horizontally in the box ----
function eq(name, boxOverride) {
  const m = M[name];
  const b = boxOverride || m.box;
  const x = b[0] + (b[2] - m.w_in) / 2;
  const y = b[1] + (b[3] - m.h_in) / 2;
  s.addImage({ path: path.join(EQ, m.image), x, y, w: m.w_in, h: m.h_in });
}
eq("s37w3_lag_orig");   // top    [0.1,0.2,0.9,0.28]
eq("s37w3_w", [1.1997, 2.175, 4.1323, 2.7]);    // top w, inside its framed box
eq("s37w3_b_orig", [4.5322, 2.175, 12.1303, 2.7]); // top b, inside its framed box
eq("s37w3_cls_orig");   // top    [0.2,0.4,0.8,0.45] on peach strip
eq("s37w3_kernelize", [7.4632, 3.7875, 10.5337, 4.2375]); // middle label box
// (kernelize image is wider than the label box; center it on the box)
eq("s37w3_lag_kern");   // bottom [0.1,0.64,0.9,0.72]
eq("s37w3_w", [1.1997, 5.4, 4.1323, 5.925]);     // bottom w, framed box
eq("s37w3_b_kern", [4.5322, 5.4, 12.1303, 5.925]); // bottom b, framed box
eq("s37w3_cls_kern");   // bottom  [0.2,0.83,0.8,0.88] on peach strip

pres.writeFile({ fileName: OUT })
  .then(() => console.log("wrote " + OUT))
  .catch(e => { console.error(e); process.exit(1); });
