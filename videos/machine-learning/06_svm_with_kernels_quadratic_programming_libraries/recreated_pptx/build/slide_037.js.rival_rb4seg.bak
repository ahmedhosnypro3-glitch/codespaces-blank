// Slide 037 — rebuild wave 4 (rb4), built ONLY from qa/reanalysis2/slide_037_analysis.txt
// + eq_037/s37rb4_manifest.json (segmented 2-D mathtext; green rects exactly
// behind highlighted term segments, peach rects behind class-of-vector lines).
// Build from project root: cd /home/codespace/ai_llm_slides && node <NS>/recreated_pptx/build/slide_037.js
const fs = require("fs");
const path = require("path");
const pptxgen = require("pptxgenjs");

const NS = "/home/codespace/ai_llm_slides/videos/machine-learning/06_svm_with_kernels_quadratic_programming_libraries";
const NUM = 37;
const W = 13.33, H = 7.5;
const EQ = path.join(__dirname, "eq_037");
const OUT = path.join(NS, "recreated_pptx", "slide_037_recreated.pptx");
const M = JSON.parse(fs.readFileSync(path.join(EQ, "s37rb4_manifest.json"), "utf8"));
const FONT = "Times New Roman";
const N = b => ({ x: b[0] * W, y: b[1] * H, w: (b[2] - b[0]) * W, h: (b[3] - b[1]) * H });

const pres = new pptxgen();
pres.layout = "LAYOUT_WIDE";
const s = pres.addSlide();
s.background = { color: "E8E8E8" };

// ---- house chrome (mandatory, overrides spec geometry) ----
s.addShape(pres.shapes.RECTANGLE, {
  x: 0.15, y: 0.15, w: W - 0.3, h: H - 0.3,
  fill: { type: "none" }, line: { color: "C00000", width: 1.5 },
});
s.addShape(pres.shapes.OVAL, {
  x: 12.48, y: 0.30, w: 0.5, h: 0.5,
  fill: { color: "FFF9C4" }, line: { color: "FFF9C4", width: 0.5 },
});
s.addText(String(NUM), {
  x: 12.48, y: 0.30, w: 0.5, h: 0.5, align: "center", valign: "middle",
  fontSize: 18, bold: true, color: "333333", fontFace: FONT, margin: 0,
});
s.addText("How to Kernelize SVM", {
  x: 0.6, y: 0.28, w: 12.13, h: 0.55, align: "center", valign: "top",
  fontSize: 24, bold: true, color: "C00000", fontFace: FONT, margin: 0,
});

// ---- spec section 4 boxes ----
function box(b, fill, line, shape) {
  const o = N(b);
  s.addShape(shape || pres.shapes.RECTANGLE, {
    x: o.x, y: o.y, w: o.w, h: o.h,
    fill: { color: fill }, line: { color: line, width: 1.25 },
  });
}
box([0.07, 0.07, 0.93, 0.16], "FFFFFF", "00008B", pres.shapes.ROUNDED_RECTANGLE);
box([0.07, 0.17, 0.93, 0.45], "F5F5F5", "00008B", pres.shapes.ROUNDED_RECTANGLE);
box([0.07, 0.49, 0.93, 0.61], "E0E0E0", "00008B", pres.shapes.ROUNDED_RECTANGLE);
box([0.07, 0.62, 0.93, 0.93], "F5F5F5", "00008B", pres.shapes.ROUNDED_RECTANGLE);
box([0.08, 0.08, 0.35, 0.14], "FFFFFF", "00008B");

// ---- peach class-line backgrounds + green term highlights (from manifest) ----
const ORDER = ["s37rb4_lag_orig", "s37rb4_w", "s37rb4_b_orig", "s37rb4_cls_orig",
  "s37rb4_kernelize", "s37rb4_lag_kern", "s37rb4_b_kern", "s37rb4_cls_kern"];
for (const k of ORDER) {
  const e = M[k];
  if (e.peach) s.addShape(pres.shapes.RECTANGLE, {
    x: e.peach.x, y: e.peach.y, w: e.peach.w, h: e.peach.h,
    fill: { color: e.peach.color }, line: { type: "none" },
  });
}
for (const k of ORDER) {
  for (const h of M[k].highlights) s.addShape(pres.shapes.RECTANGLE, {
    x: h.x, y: h.y, w: h.w, h: h.h,
    fill: { color: h.color }, line: { type: "none" },
  });
}

// ---- red down-arrow between top and middle boxes (spec [0.45,0.48,0.55,0.55]) ----
s.addShape(pres.shapes.DOWN_ARROW, Object.assign(N([0.45, 0.48, 0.55, 0.55]), {
  fill: { color: "FF0000" }, line: { color: "FF0000", width: 0.5 },
}));

// ---- example label (verbatim) ----
s.addText("Example: Polynomial Kernel", Object.assign(N([0.08, 0.08, 0.35, 0.14]), {
  align: "left", valign: "middle", fontSize: 12, color: "000000",
  fontFace: FONT, margin: 0.02,
}));

// ---- equation segment images (on top of highlights) ----
for (const k of ORDER) {
  for (const seg of M[k].segments) {
    s.addImage({ path: path.join(EQ, seg.image),
      x: seg.x, y: seg.y, w: seg.w, h: seg.h });
  }
}

pres.writeFile({ fileName: OUT })
  .then(() => console.log("wrote " + OUT))
  .catch(e => { console.error(e); process.exit(1); });
